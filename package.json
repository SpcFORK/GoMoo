{
  "name": "nodejs",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "Publishing": "echo '----  Publishing  ----'",
    "pub-gme!": "cd src/encode && npm publish",
    "pub-gme": "npm adduser && npm run pub-gme!",
    "All": "echo '----  All  ----'",
    "ba": "esbuild ./src --bundle --outdir=dist",
    "bam": "esbuild ./src --bundle --minify --sourcemap --outdir=dist",
    "baw": "esbuild ./src --bundle --minify --sourcemap --outdir=wdist --platform=browser",
    "Encode": "echo '----  Encode  ----'",
    "be": "esbuild ./src/encode --bundle --outdir=dist",
    "bew": "esbuild ./src/encode --bundle --minify --sourcemap --outdir=wdist/encode --platform=browser",
    "Bullpress": "echo '----  Bullpress  ----'",
    "b-e": "esbuild ./src/encode/bullpress/index.js --bundle --outdir=dist --platform=node --target=node10.4",
    "bw-e": "esbuild ./src/encode/bullpress/index.js --bundle --minify --sourcemap --outdir=wdist/encode/bullpress --platform=browser",
    "ba-e": "esbuild ./src/encode/bullpress --bundle --outdir=dist",
    "MUint8": "echo '----  MUint8  ----'",
    "b-m": "esbuild ./src/encode/muint8/index.js --bundle --outdir=dist --platform=node --target=node10.4",
    "bw-m": "esbuild ./src/encode/muint8/index.js --bundle --minify --sourcemap --outdir=wdist/encode/muint8 --platform=browser",
    "ba-m": "esbuild ./src/encode/muint8 --bundle --outdir=dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/node": "^18.0.6"
  },
  "devDependencies": {
    "esbuild": "^0.20.2",
    "typescript": "^5.4.5"
  }
}
